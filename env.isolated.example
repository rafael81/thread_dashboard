# 운영 thread_dashboard(3131/9224)와 겹치지 않는 개발용 값
# 사용: cp env.isolated.example .env

PORT=4131

# 운영 가시 Chrome(9224)에 붙지 않음. 실 CDP 테스트 전에는 기동하지 말 것.
CHROME_PORT=9424

TERAFABX_AUTO_COMMENT_WRITER_PORT=9338
TERAFABX_OWN_POST_REPLY_X_PORT=9339
TERAFABX_COMMENT_X_CHROME_PORT=9336
TERAFABX_VERIFIED_REVIEW_X_CHROME_PORT=9335
TERAFABX_OWN_POST_REPLY_GEMINI_PORT_BASE=9364
TERAFABX_HOME_VERIFIED_COMMENT_X_PORT=9340
TERAFABX_HOME_VERIFIED_COMMENT_GEMINI_PORT_BASE=9374

# following 합성 홈 인증 댓글 — 일 목표 500
TERAFABX_HOME_VERIFIED_COMMENT_DAILY_TARGET=500
TERAFABX_HOME_VERIFIED_COMMENT_INTERVAL_MS=150000
TERAFABX_HOME_VERIFIED_COMMENT_BATCH_LIMIT=12
TERAFABX_HOME_VERIFIED_COMMENT_AUTHOR_DAILY_LIMIT=3
TERAFABX_HOME_VERIFIED_COMMENT_READY_BUFFER=40
TERAFABX_HOME_VERIFIED_COMMENT_DISCOVER_LIMIT=100
TERAFABX_HOME_VERIFIED_COMMENT_MIN_POST_GAP_MS=180000
TERAFABX_HOME_VERIFIED_CONTEXT_PROVIDER=gemini
TERAFABX_HOME_VERIFIED_DISCOVER_SOURCE=fxtwitter-following

# Grok 세션/상태도 개발 .data 아래 (경로 기본값이 __dirname/.data 이므로 보통 생략 가능)
# TERAFABX_STATE_PATH=  (지정하지 말 것 — 운영 경로 금지)

# 안전 기본: 자동 게시 파이프는 코드/대시보드에서 off 유지 권장 (live 켤 때만 실게시)

# pinned agent-browser (avoid npx version drift)
AGENT_BROWSER_BIN=/opt/homebrew/opt/agent-browser/bin/agent-browser
